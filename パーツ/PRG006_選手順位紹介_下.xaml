<UserControl x:Class="DSDsp.パーツ.PRG006_選手順位紹介_下"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DSDsp.パーツ"
             mc:Ignorable="d" 
             d:DesignHeight="387" d:DesignWidth="641">
    <Grid>
        <Canvas x:Name="COM_種目紹介" Margin="58,249,58,7" Background="Transparent">
            <Image x:Name="IM_種目2" Height="29" Source="..\イメージ\CHR169_種目紹介2.png" Stretch="Fill" Width="441" Canvas.Left="32" Canvas.Top="63" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Image.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="IM_種目1" Height="29" Source="..\イメージ\CHR169_種目紹介1.png" Stretch="Fill" Width="443" Canvas.Left="37" Canvas.Top="68" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Image.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Image.RenderTransform>
            </Image>
            <Label x:Name="LB_区分名" Content="A級戦スタンダード" HorizontalContentAlignment="Left" Canvas.Left="20" Canvas.Top="40" HorizontalAlignment="Center" VerticalAlignment="Top" Width="372" Height="30" Foreground="Gold" FontWeight="Bold"/>
            <Label x:Name="LB_順位" Content="第3位" HorizontalContentAlignment="Left" Canvas.Left="48" Canvas.Top="65" HorizontalAlignment="Center" VerticalAlignment="Top" VerticalContentAlignment="Center" Width="332" Height="30" Foreground="White" FontSize="16" FontFamily="Segoe UI Semibold"/>
