            <Label x:Name="LB_所属" Content="所属" HorizontalContentAlignment="Right" Canvas.Left="123" Canvas.Top="66" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" Width="324" Height="30" Foreground="White" FontSize="14" FontFamily="Segoe UI Semibold"/>
            <Label x:Name="LB_得点" Content="999.99" HorizontalContentAlignment="Right" Canvas.Left="108" Canvas.Top="65" HorizontalAlignment="Center" VerticalAlignment="Top" VerticalContentAlignment="Center" Width="345" Height="30" Foreground="White" FontSize="16" FontFamily="Segoe UI Semibold"/>
        </Canvas>
    </Grid>
</UserControl>