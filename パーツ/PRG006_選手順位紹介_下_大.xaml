<UserControl x:Class="DSDsp.パーツ.PRG006_選手順位紹介_下_大"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DSDsp.パーツ"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">
    <Grid>
        <!-- 大画面（1280×720）版 選手順位紹介パーツ（PRG006_選手順位紹介_下 の大画面版） -->
        <Canvas x:Name="COM_種目紹介" Margin="116,500,116,14" Background="Transparent">
            <Image x:Name="IM_種目2" Height="58" Source="..\イメージ\CHR169_種目紹介2.png" Stretch="Fill" Width="882" Canvas.Left="64" Canvas.Top="126" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Image.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="IM_種目1" Height="58" Source="..\イメージ\CHR169_種目紹介1.png" Stretch="Fill" Width="886" Canvas.Left="74" Canvas.Top="136" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Image.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Image.RenderTransform>
            </Image>
            <Label x:Name="LB_区分名" Content="A級戦スタンダード" HorizontalContentAlignment="Left" Canvas.Left="40" Canvas.Top="80" HorizontalAlignment="Center" VerticalAlignment="Top" Width="744" Height="50" Foreground="Gold" FontWeight="Bold" FontSize="22"/>
            <Label x:Name="LB_順位" Content="第3位" HorizontalContentAlignment="Left" Canvas.Left="96" Canvas.Top="130" HorizontalAlignment="Center" VerticalAlignment="Top" VerticalContentAlignment="Center" Width="664" Height="50" Foreground="White" FontSize="28" FontFamily="Segoe UI Semibold"/>
            <Label x:Name="LB_選手名" Content="Label" HorizontalContentAlignment="Left" Canvas.Left="210" Canvas.Top="130" HorizontalAlignment="Center" VerticalAlignment="Top" Width="550" Height="50" Foreground="White" FontSize="28" FontFamily="Segoe UI Semibold"/>
            <Label x:Name="LB_所属" Content="所属" HorizontalContentAlignment="Right" Canvas.Left="246" Canvas.Top="132" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" Width="648" Height="50" Foreground="White" FontSize="24" FontFamily="Segoe UI Semibold"/>
            <Label x:Name="LB_得点" Content="999.99" HorizontalContentAlignment="Right" Canvas.Left="216" Canvas.Top="130" HorizontalAlignment="Center" VerticalAlignment="Top" VerticalContentAlignment="Center" Width="690" Height="50" Foreground="White" FontSize="28" FontFamily="Segoe UI Semibold"/>
        </Canvas>
    </Grid>
</UserControl>
