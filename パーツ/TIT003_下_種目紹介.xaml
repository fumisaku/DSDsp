<UserControl x:Class="DSDsp.パーツ.TIT003_下_種目紹介"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DSDsp.パーツ"
             mc:Ignorable="d" 
             d:DesignHeight="387" d:DesignWidth="688">
    <Grid>
        <Canvas x:Name="COM_種目紹介" Margin="58,313,58,-27" Background="Transparent">
            <Image x:Name="IM_種目2" Height="29" Source="..\イメージ\CHR169_種目紹介2.png" Stretch="Fill" Width="520" Canvas.Left="32" Canvas.Top="33" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Image.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="IM_種目1" Height="29" Source="..\イメージ\CHR169_種目紹介1.png" Stretch="Fill" Width="520" Canvas.Left="37" Canvas.Top="38" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Image.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </Image.RenderTransform>
            </Image>
            <Label x:Name="LB_種目紹介" Content="Label" HorizontalContentAlignment="Center" Canvas.Left="43" Canvas.Top="35" HorizontalAlignment="Left" VerticalAlignment="Center" Width="486" Height="30" Foreground="White" FontSize="16" FontFamily="Segoe UI Semibold">
                <Label.Effect>
                    <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="3" Opacity="1" />
                </Label.Effect>
            </Label>
            <Label x:Name="LB_種目順" Content="8種目目" HorizontalContentAlignment="Center" Canvas.Left="20" Canvas.Top="11" HorizontalAlignment="Left" VerticalAlignment="Center" Width="68" Height="30" FontWeight="Bold" Padding="0">
                <Label.ContentTemplate>
                    <DataTemplate>
                        <local:OutlinedTextBlock
                            Text="{Binding}"
                            FontSize="12" FontWeight="Bold"
                            Foreground="DarkGoldenrod" Stroke="White" StrokeThickness="1.5" />
                    </DataTemplate>
                </Label.ContentTemplate>
            </Label>
        </Canvas>
    </Grid>
</UserControl>